# Thinkflow / LearnLens AI — Environment Configuration Template

# Server Configuration
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# Database Mode: "local" (built-in SQLite/in-memory demo repository) or "supabase" (cloud PostgreSQL)
DATABASE_MODE=local

# xAI Grok API Configuration (Primary Generative AI Provider)
# Set your official xAI API key from https://console.x.ai/
XAI_API_KEY=your-xai-api-key-here
XAI_MODEL=grok-2-latest
XAI_BASE_URL=https://api.x.ai/v1
XAI_TIMEOUT_SECONDS=15.0
XAI_MAX_TOKENS=1500
XAI_MAX_RETRIES=2

# Supabase Configuration (Optional - Required only if DATABASE_MODE=supabase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-backend-only

# Gemini API Configuration (Optional - Secondary fallback)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# Security / Demo Mode
DEMO_MODE=true
SECRET_KEY=dev-secret-key-change-in-production-32bytesmin
