# Thinkflow Environment Configuration Template

# Server Configuration
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# Database Mode: "local" (built-in SQLite/in-memory demo repository) or "supabase" (cloud PostgreSQL)
DATABASE_MODE=local

# Supabase Configuration (Optional - Required only if DATABASE_MODE=supabase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-backend-only

# Gemini API Configuration (Optional - Defaults to deterministic/rule-based engine when absent)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# Security / Demo Mode
DEMO_MODE=true
SECRET_KEY=dev-secret-key-change-in-production-32bytesmin
