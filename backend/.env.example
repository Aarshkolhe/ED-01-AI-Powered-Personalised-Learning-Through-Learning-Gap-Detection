# ThinkFlow — Environment Configuration Template

# Server Configuration
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# Database Mode: "local" (built-in SQLite/in-memory demo repository) or "supabase" (cloud PostgreSQL)
DATABASE_MODE=local

# Google Gemini API Configuration (Primary Generative AI Provider)
# Set your official Google Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_actual_google_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_SECONDS=15.0
GEMINI_MAX_TOKENS=1500
GEMINI_MAX_RETRIES=2

# Supabase Configuration (Optional - Required only if DATABASE_MODE=supabase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-backend-only

# Security / Demo Mode
DEMO_MODE=true
SECRET_KEY=dev-secret-key-change-in-production-32bytesmin
