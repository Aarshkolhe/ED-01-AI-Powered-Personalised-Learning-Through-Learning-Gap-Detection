# Thinkflow / LearnLens AI — Backend Environment Template

# Server Configuration
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# Database Mode: "local" (in-memory demo repository with SQLite support) or "supabase"
DATABASE_MODE=local

# xAI Grok API Configuration (Primary Generative AI Provider)
# Obtain your key from https://console.x.ai/ (official xAI API)
# API calls are made server-side only; this key is never exposed to clients.
XAI_API_KEY=your-xai-api-key-here
XAI_MODEL=grok-2-latest
XAI_BASE_URL=https://api.x.ai/v1
XAI_TIMEOUT_SECONDS=15.0
XAI_MAX_TOKENS=1500
XAI_MAX_RETRIES=2

# Supabase Configuration (Optional - Required only if DATABASE_MODE=supabase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-backend-only

# Legacy / Alternate AI (Optional fallback)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# Security / Demo Mode
DEMO_MODE=true
SECRET_KEY=dev-secret-key-change-in-production-32bytesmin
